NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:password@localhost:5432/vifaa

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
JWT_ACCESS_COOKIE_NAME=token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_SESSION_REDIS_PREFIX=refresh:

FRONTEND_URL=http://localhost:5173

# Tâches planifiées (header X-Cron-Secret) — voir docs/cron-jobs.md
CRON_SECRET=change-me-cron-secret

# E-mails (alertes = notification in-app + e-mail si activé)
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=erp@vifaa.local

PASSWORD_ROUNDS=12
SEED_ORGANIZATION_NAME=VIFAA
SEED_ADMIN_EMAIL=admin@vifaa.local
SEED_ADMIN_PASSWORD=change-me
# Prénom / nom du compte provisionné : facultatifs (absents ou vides → null en base).
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=VIFAA
SEED_ADMIN_ROLE=ADMIN
EMAIL_ADMIN=
PASSWORD_ADMIN=

THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000

# Cloudflare R2 — photos de profil (Sharp → WebP avant upload)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# URL publique de lecture (domaine custom ou *.r2.dev), sans slash final
CLOUDFLARE_R2_PUBLIC_BASE_URL=
MAX_LOGIN_FAILS=5
BLOCK_SECONDS=900
FAIL_COUNTER_TTL_SECONDS=900
