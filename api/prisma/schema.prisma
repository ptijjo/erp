// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  MAIN
  SUBSIDIARY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum StockOrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Charges fixes (loyer, salaires…) vs variables (stock, maintenance…).
enum BudgetLineNature {
  FIXED
  VARIABLE
}

/// Lignes budgétaires (prévision) ; sorties réelles via `BudgetExpense`.
enum BudgetLineCategory {
  LOYER
  SALAIRE
  ELECTRICITE
  EAU
  INTERNET
  ASSURANCE
  STOCK
  MAINTENANCE
  MATERIEL
  TRANSPORT
  AUTRE
}

enum BudgetSupplementStatus {
  PENDING_FINANCE
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmploymentContractType {
  CDI
  CDD
  STAGE
  INTERIM
  OTHER
}

enum EmploymentContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum LeaveType {
  PAID_LEAVE // Congés Payés
  RTT
  SICK_LEAVE // Maladie
  UNPAID_LEAVE // Sans solde
}

enum VenteStatut {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ModePaiement {
  ESPECES
  CARTE
  MOBILE_MONEY
}

enum SessionCaisseStatut {
  OUVERTE
  CLOTUREE
}

enum StockMovementType {
  RECEIPT_STOCK_ORDER
  SALE
  SALE_RETURN
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  INVENTORY
}

enum StockTransferStatus {
  PENDING
  SHIPPED
  RECEIVED
  CANCELLED
}

enum HeritageAssetStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum LegalContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  firstName       String?
  lastName        String?
  /// URL publique de la photo de profil (stockage objet à brancher côté upload).
  profilePhotoUrl String?
  /// Tant que `true`, l’utilisateur doit définir son mot de passe (première connexion).
  firstLogin      Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  loginAttempts  LoginAttempt[]
  auditLogs      AuditLog[]
  stockOrders    StockOrder[]
  ventes         Vente[]
  venteReturns   VenteReturn[]
  sessionsCaisseOpened SessionCaisse[] @relation("SessionCaisseOpenedBy")
  sessionsCaisseClosed SessionCaisse[] @relation("SessionCaisseClosedBy")
  stockTransfersRequested StockTransfer[]
  stockMovementsRecorded  StockMovement[]
  budgetExpenses              BudgetExpense[]
  budgetsSubmitted            Budget[]                  @relation("BudgetSubmittedBy")
  budgetsApproved             Budget[]                  @relation("BudgetApprovedBy")
  budgetsRejected             Budget[]                  @relation("BudgetRejectedBy")
  budgetSupplementsRequested  BudgetSupplementRequest[] @relation("BudgetSupplementRequestedBy")
  budgetSupplementsReviewed   BudgetSupplementRequest[] @relation("BudgetSupplementReviewedBy")
  budgetSupplementsDecided    BudgetSupplementRequest[] @relation("BudgetSupplementDecidedBy")
  notifications               Notification[]
  accountingPeriodClosures    AccountingPeriodClosure[] @relation("AccountingPeriodClosedBy")
  messageThreadParticipants   MessageThreadParticipant[]
  messagesSent                Message[]

  /// Fiche RH optionnelle (auth / rôles / permissions restent sur `User`).
  employee Employee?
}

/// Pôle métier de la maison mère (ex. opérations, finances). ADMIN et DIRECTOR_GENERAL n’y sont pas rattachés.
model Pole {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles Role[]
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  /// Rôle défini pour cette organisation (ex. directions de la maison mère). Null = rôle global (ex. ADMIN).
  organizationScopeId String?
  organizationScope   Organization? @relation("RoleOrganizationScope", fields: [organizationScopeId], references: [id], onDelete: Restrict)

  /// Pôle pour les rôles de direction (null pour ADMIN, DIRECTOR_GENERAL, rôles filiales).
  poleId String?
  pole   Pole?   @relation(fields: [poleId], references: [id], onDelete: SetNull)

  users           User[]
  permissionRoles PermissionRole[]

  @@index([poleId])
}

model Organization {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  organizationType OrganizationType
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  //Relations
  users            User[]
  scopedRoles      Role[]           @relation("RoleOrganizationScope")
  stocks           Stock[]
  auditLogs        AuditLog[]

  /// Fournisseurs référencés par la maison mère (création / pilotage).
  suppliersCreated Supplier[] @relation("SupplierCreatedByOrg")

  /// Catégories du catalogue attribuées à cette filiale (maison mère).
  catalogCategories OrganizationCatalogCategory[]
  /// Produits supplémentaires attribués à cette filiale (en plus de ceux des catégories).
  catalogProducts   OrganizationCatalogProduct[]
  stockOrders       StockOrder[]
  ventes            Vente[]
  venteReturns      VenteReturn[]
  sessionsCaisse    SessionCaisse[]
  stockMovements    StockMovement[]
  stockTransfersOut StockTransfer[] @relation("StockTransferFrom")
  stockTransfersIn  StockTransfer[] @relation("StockTransferTo")
  heritageAssets    HeritageAsset[]
  legalContracts    LegalContract[]
  productionOrders  ProductionOrder[]
  /// Budgets où cette organisation est la filiale concernée.
  budgets           Budget[]

  departments   Department[]
  employees     Employee[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  notifications Notification[]
  accountingPeriodClosures AccountingPeriodClosure[]

  @@index([organizationType])
}

/// Catégorie (et sous-arbre) incluse dans le catalogue d’une filiale.
model OrganizationCatalogCategory {
  organizationId String
  categoryId     String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([organizationId, categoryId])
  @@index([categoryId])
}

/// Produit additionnel dans le catalogue d’une filiale (doit rester `offeredToSubsidiaries`).
model OrganizationCatalogProduct {
  organizationId String
  productId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([organizationId, productId])
  @@index([productId])
}

/// Piste d’audit : utilisateur, action, entité, horodatage (remplir depuis les services ou un interceptor Nest).
model AuditLog {
  id         String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  action     AuditAction
  /// Nom du domaine / modèle (ex. "Vente", "Product").
  entityType String
  /// Identifiant métier de l’enregistrement concerné.
  entityId   String?
  /// Détail libre (avant/après, champs touchés, message, etc.).
  details    Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Contexte organisationnel au moment de l’action (filtrage des rapports).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([organizationId])
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  permissionRoles PermissionRole[]
}

model PermissionRole {
  id           String     @id @default(uuid())
  permissionId String
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([permissionId, roleId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  ipAddress String
  userAgent String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipAddress, userAgent])
  @@index([userId])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  //relations
  products                   Product[]
  organizationCatalogEntries OrganizationCatalogCategory[]

  @@unique([parentId, name]) // optionnel : même nom autorisé sous un autre parent, interdit en doublon sous le même parent
  @@index([parentId])
}

/// Fournisseur choisi par la maison mère pour les commandes de réapprovisionnement des filiales.
model Supplier {
  id        String   @id @default(uuid())
  name      String
  price     Decimal  @default(0)
  email     String?
  phone     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Organisation maison mère qui a créé la fiche fournisseur (null si import migré).
  createdByOrganizationId String?
  createdByOrganization   Organization? @relation("SupplierCreatedByOrg", fields: [createdByOrganizationId], references: [id], onDelete: SetNull)

  productSuppliers ProductSupplier[]
  stockOrders      StockOrder[]

  @@index([createdByOrganizationId])
}

/// Fournisseurs autorisés pour un produit (maison mère). La filiale choisit l’un d’eux à la commande.
model ProductSupplier {
  productId  String
  supplierId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
  @@index([supplierId])
}

model Product {
  id                    String    @id @default(uuid())
  name                  String    @unique
  description           String?
  price                 Decimal
  /// Valeur encodée dans le QR et lue par la douchette ; unique pour identification (lookup par scan).
  qrCode                String    @unique @default(uuid())
  /// Si vrai, les organisations filiales peuvent voir, vendre et stocker ce produit (défini par la maison mère).
  offeredToSubsidiaries Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  productSuppliers           ProductSupplier[]
  stocks                     Stock[]
  organizationCatalogEntries OrganizationCatalogProduct[]
  stockOrders                StockOrder[]
  venteLines                 VenteLine[]
  stockMovements             StockMovement[]
  stockTransfers             StockTransfer[]
  productionOrders           ProductionOrder[]
  venteReturnLines           VenteReturnLine[]

  @@index([offeredToSubsidiaries])
}

/// Session de caisse : fond d’ouverture, ventes du service, clôture avec écart.
model SessionCaisse {
  id        String             @id @default(uuid())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  statut    SessionCaisseStatut @default(OUVERTE)
  openedAt  DateTime           @default(now())
  closedAt  DateTime?

  fondOuverture Decimal
  fondCloture   Decimal?
  /// Écart à la clôture : fond déclaré − (fond ouverture + encaissements espèces).
  ecartCloture  Decimal?
  commentaireCloture String?

  /// Totaux figés à la clôture.
  totalVentesFcfa      Decimal?
  totalEspecesFcfa     Decimal?
  totalCarteFcfa       Decimal?
  totalMobileMoneyFcfa Decimal?
  nombreVentes         Int?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("SessionCaisseOpenedBy", fields: [userId], references: [id], onDelete: Restrict)

  closedByUserId String?
  closedBy       User?   @relation("SessionCaisseClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  ventes Vente[]

  @@index([organizationId])
  @@index([userId])
  @@index([statut])
  @@index([openedAt])
}

/// Vente en point de vente (filiale) — brouillon puis confirmation avec décrément stock.
model Vente {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  status    VenteStatut @default(DRAFT)
  totalAmount Decimal   @default(0)
  numeroTicket Int?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessionCaisseId String?
  sessionCaisse   SessionCaisse? @relation(fields: [sessionCaisseId], references: [id], onDelete: Restrict)

  lines     VenteLine[]
  paiements VentePaiement[]
  returns   VenteReturn[]

  @@unique([sessionCaisseId, numeroTicket])
  @@index([organizationId])
  @@index([userId])
  @@index([sessionCaisseId])
  @@index([status])
  @@index([createdAt])
}

model VenteLine {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quantity  Int
  /// Prix unitaire FCFA figé à l’ajout de la ligne (copie du catalogue).
  unitPrice Decimal

  venteId String
  vente   Vente  @relation(fields: [venteId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([venteId, productId])
  @@index([venteId])
  @@index([productId])
}

/// Paiements enregistrés à la confirmation (plusieurs modes possibles).
model VentePaiement {
  id        String       @id @default(uuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  modePaiement ModePaiement
  amount    Decimal

  venteId String
  vente   Vente  @relation(fields: [venteId], references: [id], onDelete: Cascade)

  @@index([venteId])
}

/// Commande de réapprovisionnement (filiale → fournisseur désigné par la maison mère sur le produit).
/// À la confirmation par la filiale (réception), la quantité est ajoutée au stock filiale.
model StockOrder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subsidiaryOrganizationId String
  subsidiaryOrganization   Organization @relation(fields: [subsidiaryOrganizationId], references: [id], onDelete: Restrict)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// Prix unitaire FCFA figé au moment de la commande (copie du tarif fournisseur catalogue).
  unitPrice Decimal @default(0)

  quantity Int
  status   StockOrderStatus @default(PENDING)
  note     String?

  requestedByUserId String?
  requestedBy       User?   @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  budgetExpense BudgetExpense?

  @@index([subsidiaryOrganizationId])
  @@index([status])
  @@index([productId])
  @@index([supplierId])
}

/// Stock courant et seuils min / max par organisation et par produit.
model Stock {
  id          String   @id @default(uuid())
  quantity    Int      @default(0)
  /// Seuil bas (alerte réapprovisionnement, etc.).
  minQuantity Int      @default(0)
  /// Plafond cible ou limite ; null = pas de maximum défini en base.
  maxQuantity Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([organizationId, productId])
  @@index([productId])
}

/// Budget mensuel pour une filiale — proposition pôle finance, validation DG / opérations.
model Budget {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subsidiaryOrganizationId String
  subsidiaryOrganization   Organization @relation(fields: [subsidiaryOrganizationId], references: [id], onDelete: Restrict)

  year  Int
  month Int

  status BudgetStatus @default(DRAFT)

  /// Note du pôle finance lors de la soumission pour validation.
  financeNote String?

  submittedAt       DateTime?
  submittedByUserId String?
  submittedBy       User?     @relation("BudgetSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  approvedAt       DateTime?
  approvedByUserId String?
  approvedBy       User?     @relation("BudgetApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  rejectedAt        DateTime?
  rejectedByUserId  String?
  rejectedBy        User?     @relation("BudgetRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  rejectionReason   String?

  lines               BudgetLine[]
  supplementRequests  BudgetSupplementRequest[]

  @@unique([subsidiaryOrganizationId, year, month])
  @@index([subsidiaryOrganizationId])
  @@index([status])
}

model BudgetLine {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  nature        BudgetLineNature @default(FIXED)
  category      BudgetLineCategory
  /// Libellé métier (ex. « Loyer siège »).
  label         String
  amountPlanned Decimal

  expenses BudgetExpense[]

  @@index([budgetId])
}

/// Demande de rallonge budgétaire (filiale → finance → DG / opérations).
model BudgetSupplementRequest {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  amountRequested Decimal
  reason          String
  status          BudgetSupplementStatus @default(PENDING_FINANCE)

  financeNote String?

  requestedByUserId String
  requestedBy       User   @relation("BudgetSupplementRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedBy       User?     @relation("BudgetSupplementReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  decidedAt       DateTime?
  decidedByUserId String?
  decidedBy       User?     @relation("BudgetSupplementDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  rejectionReason String?

  @@index([budgetId])
  @@index([status])
}

/// Sortie réelle saisie sur une ligne budgétaire validée (filiale).
model BudgetExpense {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgetLineId String
  budgetLine   BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)

  amount  Decimal
  /// Détail optionnel (ex. « Acompte janvier »).
  label   String?
  spentAt DateTime @default(now())

  recordedByUserId String?
  recordedBy       User?   @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  /// Renseigné lorsque la sortie provient d’une commande stock confirmée.
  stockOrderId String?    @unique
  stockOrder   StockOrder? @relation(fields: [stockOrderId], references: [id], onDelete: SetNull)

  @@index([budgetLineId])
  @@index([stockOrderId])
}

/// Service / unité organisationnelle (tenant = `organizationId`).
model Department {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employees Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Employé métier : pas de mot de passe ni de rôle (voir `User`).
model Employee {
  id        String         @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  position  String?
  status    EmployeeStatus @default(ACTIVE)

  hireDate        DateTime
  terminationDate DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  managerId    String?
  manager      Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeManager")

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  leaveRequests  LeaveRequest[]
  leaveApprovals LeaveRequest[]       @relation("LeaveApprovedBy")
  leaveBalances  LeaveBalance[]
  contracts      EmploymentContract[]
  salaries       EmployeeSalary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([status])
}

model LeaveRequest {
  id        String      @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  reason    String?
  type      LeaveType @default(PAID_LEAVE)
  status    LeaveStatus @default(PENDING)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  approvedById String?
  approvedBy   Employee? @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([organizationId])
  @@index([status])
}

/// Solde de congés par exercice (renouvellement en mai : `year` = année du mois de mai).
model LeaveBalance {
  id        String @id @default(uuid())
  /// Exercice mai N → avril N+1 (ex. `year = 2026` pour mai 2026 – avril 2027).
  year      Int
  /// Quota = 30 j/an + jours reportés des exercices précédents (cumul).
  totalDays Int
  usedDays  Int    @default(0)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year])
  @@index([organizationId])
}

/// Contrat de travail (historique possible par employé).
model EmploymentContract {
  id        String                   @id @default(uuid())
  type      EmploymentContractType
  status    EmploymentContractStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime?
  note      String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([organizationId])
}

/// Rémunération (montants en Decimal, pas de Float).
model EmployeeSalary {
  id            String    @id @default(uuid())
  amount        Decimal
  /// Début de période de validité du salaire.
  effectiveFrom DateTime
  effectiveTo   DateTime?
  label         String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([organizationId])
}

enum NotificationType {
  LEAVE_REQUEST_PENDING
  STOCK_LOW_AFTER_SALE
  BUDGET_PENDING_APPROVAL
  BUDGET_UTILIZATION_WARNING
}

/// Alerte in-app pour l’utilisateur connecté.
model Notification {
  id        String           @id @default(uuid())
  createdAt DateTime         @default(now())
  readAt    DateTime?
  type      NotificationType
  title     String
  body      String
  metadata  Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([organizationId])
  @@index([createdAt])
}

/// Clôture comptable mensuelle : verrouille les écritures sur la période.
model AccountingPeriodClosure {
  id       String   @id @default(uuid())
  year     Int
  month    Int
  closedAt DateTime @default(now())

  /// `null` = clôture groupe (toutes les organisations).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  closedByUserId String
  closedBy       User   @relation("AccountingPeriodClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)

  @@unique([year, month, organizationId])
  @@index([year, month])
}

enum MessageThreadScope {
  SUBSIDIARY_TO_SUBSIDIARY
  SUBSIDIARY_TO_MAIN
  MAIN_INTRA_POLE
  MAIN_CROSS_POLE
}

/// Fil de messagerie interne (deux interlocuteurs).
model MessageThread {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scope    MessageThreadScope
  poleCode String?

  participants MessageThreadParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model MessageThreadParticipant {
  id         String    @id @default(uuid())
  threadId   String
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?

  @@unique([threadId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  body      String

  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@index([senderId])
}

/// Journal des mouvements de stock (traçabilité filiale).
model StockMovement {
  id             String            @id @default(uuid())
  createdAt      DateTime          @default(now())
  quantityDelta  Int
  type           StockMovementType
  referenceType  String?
  referenceId    String?
  label          String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  recordedByUserId String?
  recordedBy       User?   @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

/// Transfert de stock entre organisations (filiale ↔ filiale ou maison mère ↔ filiale).
model StockTransfer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromOrganizationId String
  fromOrganization   Organization @relation("StockTransferFrom", fields: [fromOrganizationId], references: [id], onDelete: Restrict)

  toOrganizationId String
  toOrganization   Organization @relation("StockTransferTo", fields: [toOrganizationId], references: [id], onDelete: Restrict)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int
  status   StockTransferStatus @default(PENDING)
  note     String?

  requestedByUserId String?
  requestedBy       User?   @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  shippedAt  DateTime?
  receivedAt DateTime?

  @@index([fromOrganizationId])
  @@index([toOrganizationId])
  @@index([status])
  @@index([productId])
}

/// Retour / avoir sur une vente confirmée (réintègre le stock).
model VenteReturn {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  reason    String?
  totalAmount Decimal @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  venteId String
  vente   Vente  @relation(fields: [venteId], references: [id], onDelete: Restrict)

  recordedByUserId String?
  recordedBy       User?   @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  lines VenteReturnLine[]

  @@index([organizationId])
  @@index([venteId])
  @@index([createdAt])
}

model VenteReturnLine {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  quantity  Int
  unitPrice Decimal

  venteReturnId String
  venteReturn   VenteReturn @relation(fields: [venteReturnId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([venteReturnId])
  @@index([productId])
}

/// Patrimoine / actifs (pôle architecture & héritage).
model HeritageAsset {
  id          String              @id @default(uuid())
  name        String
  description String?
  location    String?
  acquiredAt  DateTime?
  value       Decimal?
  status      HeritageAssetStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([status])
}

/// Contrats juridiques (pôle legal).
model LegalContract {
  id        String              @id @default(uuid())
  title     String
  partyName String
  startDate DateTime?
  endDate   DateTime?
  status    LegalContractStatus @default(DRAFT)
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([status])
  @@index([endDate])
}

/// Ordre de production (pôle production).
model ProductionOrder {
  id          String                @id @default(uuid())
  title       String
  quantity    Int
  status      ProductionOrderStatus @default(PLANNED)
  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
  @@index([productId])
}
