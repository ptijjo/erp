# Copier vers .env — URL de l’API Nest (ex. http://localhost:8686)
# En Docker Compose : même valeur (navigateur → API sur l’hôte, ports 3005 / 8686)
NEXT_PUBLIC_BASE_URL=http://localhost:8686

# Aligné sur JWT_ACCESS_EXPIRES_SECONDS de l’API (refresh proactif à ~70 % de cette durée).
NEXT_PUBLIC_JWT_ACCESS_EXPIRES_SECONDS=3600

# Noms de cookies (optionnel, mêmes valeurs que l’API) — utilisés par le middleware Next.
# JWT_ACCESS_COOKIE_NAME=token
# REFRESH_TOKEN_COOKIE_NAME=refresh_token
