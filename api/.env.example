JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
JWT_ACCESS_COOKIE_NAME=token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_SESSION_REDIS_PREFIX=refresh:

FRONTEND_URL=http://localhost:5173

PASSWORD_ROUNDS=12
SEED_ORGANIZATION_NAME=VIFAA
SEED_ADMIN_EMAIL=admin@vifaa.local
SEED_ADMIN_PASSWORD=change-me
# Prénom / nom du compte provisionné : facultatifs (absents ou vides → null en base).
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=VIFAA
SEED_ADMIN_ROLE=ADMIN
EMAIL_ADMIN=
PASSWORD_ADMIN=

THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
MAX_LOGIN_FAILS=5
BLOCK_SECONDS=900
FAIL_COUNTER_TTL_SECONDS=900
